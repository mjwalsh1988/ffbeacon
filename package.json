{
  "name": "ffbeacon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync:players": "tsx --env-file=.env.local scripts/sync-sleeper-players.ts",
    "sync:league": "tsx --env-file=.env.local scripts/sync-league.ts",
    "sync:ktc": "tsx --env-file=.env.local scripts/sync-ktc.ts",
    "sync:fantasycalc": "tsx --env-file=.env.local scripts/sync-fantasycalc.ts",
    "sync:stats": "tsx --env-file=.env.local scripts/sync-sleeper-stats.ts",
    "seed:rankings": "tsx --env-file=.env.local scripts/seed-rankings.ts",
    "calculate:trends": "tsx --env-file=.env.local scripts/calculate-trends.ts",
    "calculate:power-rankings": "tsx --env-file=.env.local scripts/calculate-league-power-rankings.ts",
    "sync:ktc:full": "npm run sync:ktc && npm run seed:rankings && npm run calculate:trends",
    "sync:full": "npm run sync:ktc && npm run sync:fantasycalc && npm run seed:rankings && npm run calculate:trends",
    "backfill:ktc": "tsx --env-file=.env.local scripts/backfill-ktc-history.ts",
    "backfill:all": "npm run backfill:ktc && npm run calculate:trends"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "geist": "^1.3.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
