{
  "name": "ffbeacon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-reserved-routes.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:routes": "tsx scripts/check-reserved-routes.ts",
    "sync:players": "tsx --env-file=.env.local scripts/sync-sleeper-players.ts",
    "pulse:league": "tsx --env-file=.env.local scripts/pulse-league.ts",
    "sync:ktc": "tsx --env-file=.env.local scripts/sync-ktc.ts",
    "sync:fantasycalc": "tsx --env-file=.env.local scripts/sync-fantasycalc.ts",
    "sync:dynastyprocess": "tsx --env-file=.env.local scripts/sync-dynastyprocess.ts",
    "calculate:beacon": "tsx --env-file=.env.local scripts/calculate-beacon-values.ts",
    "beacon:tests": "tsx --env-file=.env.local scripts/beacon-reliability-tests.ts",
    "beacon:audit": "tsx --env-file=.env.local scripts/beacon-normalization-audit.ts",
    "beacon:offset-test": "tsx scripts/beacon-offset-trends-test.ts",
    "beacon:outage": "tsx --env-file=.env.local scripts/beacon-outage-sim.ts",
    "beacon:board": "tsx --env-file=.env.local scripts/beacon-board-audit.ts",
    "beacon:ai-smoke": "tsx --env-file=.env.local scripts/beacon-ai-smoke.ts",
    "beacon-brief": "tsx --env-file=.env.local scripts/beacon-brief.ts",
    "beacon-brief:tests": "tsx scripts/beacon-brief-ingest-tests.ts",
    "sync:stats": "tsx --env-file=.env.local scripts/sync-sleeper-stats.ts",
    "seed:rankings": "tsx --env-file=.env.local scripts/seed-rankings.ts",
    "calculate:trends": "tsx --env-file=.env.local scripts/calculate-trends.ts",
    "calculate:power-rankings": "tsx --env-file=.env.local scripts/calculate-league-power-rankings.ts",
    "sync:ktc:full": "npm run sync:ktc && npm run seed:rankings && npm run calculate:trends",
    "sync:full": "npm run sync:ktc && npm run sync:fantasycalc && npm run sync:dynastyprocess && npm run seed:rankings && npm run calculate:trends",
    "backfill:sleeper-stats": "tsx --env-file=.env.local scripts/backfill-sleeper-stats.ts",
    "backfill:ktc": "tsx --env-file=.env.local scripts/backfill-ktc-history.ts",
    "backfill:ktc:community": "tsx --env-file=.env.local scripts/backfill-ktc-community-archive.ts",
    "backfill:dynastyprocess": "tsx --env-file=.env.local scripts/backfill-dynastyprocess-history.ts",
    "backfill:all": "npm run backfill:ktc && npm run backfill:dynastyprocess && npm run calculate:trends"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
