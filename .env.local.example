# FF Beacon environment template
# Copy this to .env.local and fill in values for Supabase project cilvpyivysjxpxbudkfa.
# Never commit .env.local. Never use the old anon/service_role key names.

# Supabase (NEW key format)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OAuth providers (configured in Supabase Auth dashboard, redirect uri is /auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Anthropic (server-side content generation)
ANTHROPIC_API_KEY=

# IndexNow (search engine ping on publish)
INDEXNOW_KEY=

# Sleeper API (no key required, listed for documentation)
# SLEEPER_BASE_URL=https://api.sleeper.app/v1

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://ffbeacon.com
