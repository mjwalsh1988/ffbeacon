# FF Beacon environment template
# Copy this to .env.local and fill in values for Supabase project cilvpyivysjxpxbudkfa.
# Never commit .env.local. Never use the old anon/service_role key names.

# Supabase (NEW key format)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OAuth providers (configured in Supabase Auth dashboard, redirect uri is /auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Anthropic (server-side content generation)
ANTHROPIC_API_KEY=

# IndexNow (search engine ping on publish)
INDEXNOW_KEY=

# Vercel Cron auth: set the same value here and in the Vercel dashboard env vars.
# Cron endpoints under /api/cron/* require: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Sleeper API (no key required, listed for documentation)
# SLEEPER_BASE_URL=https://api.sleeper.app/v1

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://ffbeacon.com

# Signal Scout guest IP hashing (optional locally; REQUIRED in Vercel Production).
# Strengthens the guest daily-round cap: without it the code falls back to a
# checked-in public constant, so the IP-hash side of the cap is precomputable.
SIGNAL_SCOUT_IP_SALT=replace-with-long-random-secret

# Donations (Stripe). Card and wallet donations are DISABLED until the secret
# key is a real one: lib/donate/stripe.ts checks its shape, so a placeholder or
# a value pasted onto the wrong line is refused with a clear log line instead of
# failing later as a 401 that looks like a Stripe outage.
#   Must start with sk_test_, sk_live_, rk_test_ or rk_live_.
# PayPal and Venmo need no configuration at all; they are plain links.
STRIPE_SECRET_KEY=

# Not read by any code. Hosted Stripe Checkout runs on Stripe's own domain, so
# there is no client-side Stripe.js and nothing to publish a key to. Kept only
# for a future embedded Payment Element.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Pins the Stripe API version for every request. Leave blank to use
# the account's own default, which is what the four fields we read are stable
# across anyway.
STRIPE_API_VERSION=

# Donation receipts. FF Beacon sends its own branded receipt through Resend when
# Stripe reports a completed donation, so this is the signing secret for the
# webhook endpoint at /api/donate/webhook (Stripe Dashboard, Developers,
# Webhooks, "Signing secret"). Starts with whsec_.
#
# WITHOUT IT NO RECEIPT IS SENT, ON PURPOSE. The endpoint is a public POST that
# emails an address named in the request body, so an unverifiable request is
# refused rather than trusted. Donations still complete; only the receipt is
# missing, and every refused request is logged.
STRIPE_WEBHOOK_SECRET=
